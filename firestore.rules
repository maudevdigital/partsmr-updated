rules_version = '2';

// Acceso totalmente cerrado a cualquier cliente.
//
// Ninguna parte de la app escribe o lee Firestore desde el navegador: todo pasa
// por API routes del servidor (src/app/api/*) que usan el Admin SDK, y el Admin
// SDK se autentica con una cuenta de servicio, por lo que estas reglas no lo
// afectan. Si en el futuro algo deja de guardarse, la solucion NO es abrir estas
// reglas: es mover esa escritura a una API route.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
